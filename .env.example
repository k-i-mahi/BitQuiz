# PostgreSQL connection used by the app. On Neon: the pooled URL plus "&pgbouncer=true".
DATABASE_URL="postgresql://bitquiz:bitquiz@localhost:5432/bitquiz?schema=public"
# Direct connection used for migrations. Locally the same as DATABASE_URL; on Neon the non-pooled URL.
DIRECT_URL="postgresql://bitquiz:bitquiz@localhost:5432/bitquiz?schema=public"

# Long random string used to sign admin session cookies (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Public base URL used in the join link and QR code shown on the projector
PUBLIC_URL="http://localhost:5173"

# HTTP port for the server
PORT=3000

# Extra time (ms) after the deadline during which answers in flight are still accepted
ANSWER_GRACE_MS=1000

# Maximum network-latency compensation (ms) subtracted from a participant's answer time
LATENCY_CAP_MS=500

# First owner account, created by `npm run db:seed` (change the password after first login)
SEED_ADMIN_EMAIL="admin@bitquiz.local"
SEED_ADMIN_PASSWORD="change-me-now"
SEED_ORG_NAME="IEEE CS KUET"

# Host port the docker-compose database is published on (change if 5432 is taken)
DB_PORT=5432
